# CareerPath Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# Authentication
JWT_SECRET=careerpath_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=careerpath_db

# Fallback Mode: When true, automatically initializes in-memory/JSON relational database if MySQL server is not locally running
ENABLE_IN_MEMORY_FALLBACK=true
